# Copy to secret.env (git-ignored) and fill in, then:
#   oc create secret generic pseudoco-assistant-secrets --from-env-file=secret.env
# Generate ACCESS_KEY with: openssl rand -hex 24
# Any non-empty value satisfies the Ray Serve endpoint; it does not gate on it.
OPENAI_API_KEY=
AI_DEFENSE_API_KEY=
ACCESS_KEY=
